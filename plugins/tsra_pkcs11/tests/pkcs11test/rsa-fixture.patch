+    CK_OBJECT_CLASS public_class = CKO_PUBLIC_KEY;
+    CK_ATTRIBUTE find[] = {{CKA_CLASS, &public_class, sizeof(public_class)}, id};
+    CK_ULONG found = 0;
+    EXPECT_CKR_OK(g_fns->C_FindObjectsInit(session_, find, 2));
+    EXPECT_CKR_OK(g_fns->C_FindObjects(session_, &public_key_, 1, &found));
+    EXPECT_CKR_OK(g_fns->C_FindObjectsFinal(session_));
+    EXPECT_EQ(1u, found) << "the unwrap leaves the public key";
   }

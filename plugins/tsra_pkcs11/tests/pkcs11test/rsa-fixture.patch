-    CK_ATTRIBUTE public_exponent = {CKA_PUBLIC_EXPONENT, public_exponent_value, sizeof(public_exponent_value)};
-    public_attrs_.push_back(public_exponent);
-
+    // The token generates no RSA keys: unwrap the RSA-2048 key run.sh wrapped
+    // for the token's unwrapping key, and take the public key the unwrap
+    // leaves, found by a CKA_ID of this pair's own.
+    std::vector<CK_BYTE> blob;
+    const char* path = std::getenv("TSRA_PKCS11TEST_RSA_BLOB");
+    FILE* f = (path != nullptr) ? fopen(path, "rb") : nullptr;
+    EXPECT_NE(nullptr, f) << "TSRA_PKCS11TEST_RSA_BLOB names no readable file";
+    if (f == nullptr) return;
+    for (int c = fgetc(f); c != EOF; c = fgetc(f)) blob.push_back((CK_BYTE)c);
+    fclose(f);
+    static unsigned long serial = 0;
+    id_ = "pkcs11test-keypair-" + std::to_string(++serial);
+    CK_ATTRIBUTE id = {CKA_ID, (CK_VOID_PTR)id_.data(), id_.size()};
+    CK_ATTRIBUTE cls = {CKA_CLASS, &private_class_, sizeof(private_class_)};
+    CK_ATTRIBUTE type = {CKA_KEY_TYPE, &rsa_, sizeof(rsa_)};
     CK_ATTRIBUTE public_object = {CKA_PRIVATE, (CK_VOID_PTR)&g_ck_false, sizeof(CK_BBOOL)};
-    public_attrs_.push_back(public_object);
+    private_attrs_.push_back(cls);
+    private_attrs_.push_back(type);
+    private_attrs_.push_back(id);
     private_attrs_.push_back(public_object);
 
-    CK_MECHANISM mechanism = {CKM_RSA_PKCS_KEY_PAIR_GEN, NULL_PTR, 0};
-    EXPECT_CKR_OK(g_fns->C_GenerateKeyPair(session_, &mechanism,
-                                           public_attrs_.data(), public_attrs_.size(),
-                                           private_attrs_.data(), private_attrs_.size(),
-                                           &public_key_, &private_key_));
+    CK_ULONG bits = 2048;
+    CK_ATTRIBUTE wrap_pub[] = {{CKA_MODULUS_BITS, &bits, sizeof(bits)},
+                               {CKA_WRAP, (CK_VOID_PTR)&g_ck_true, sizeof(CK_BBOOL)}};
+    CK_ATTRIBUTE wrap_priv[] = {{CKA_UNWRAP, (CK_VOID_PTR)&g_ck_true, sizeof(CK_BBOOL)}};
+    CK_OBJECT_HANDLE unwrapping_pub = INVALID_OBJECT_HANDLE;
+    CK_OBJECT_HANDLE unwrapping = INVALID_OBJECT_HANDLE;
+    CK_MECHANISM gen = {CKM_RSA_PKCS_KEY_PAIR_GEN, NULL_PTR, 0};
+    EXPECT_CKR_OK(g_fns->C_GenerateKeyPair(session_, &gen, wrap_pub, 2, wrap_priv, 1,
+                                           &unwrapping_pub, &unwrapping));
+    CK_RSA_PKCS_OAEP_PARAMS oaep = {CKM_SHA256, CKG_MGF1_SHA256, CKZ_DATA_SPECIFIED, NULL_PTR, 0};
+    struct { CK_ULONG ulAESKeyBits; CK_RSA_PKCS_OAEP_PARAMS_PTR pOAEPParams; } wrap = {256, &oaep};
+    CK_MECHANISM unwrap = {0x00001054UL /* CKM_RSA_AES_KEY_WRAP */, &wrap, sizeof(wrap)};
+    EXPECT_CKR_OK(g_fns->C_UnwrapKey(session_, &unwrap, unwrapping, blob.data(), blob.size(),
+                                     private_attrs_.data(), private_attrs_.size(),

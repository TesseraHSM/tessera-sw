#
# Used by the CLI commands (genpkey, req) to load the provider and route
# algorithm lookups to tsra via default_properties.

openssl_conf = openssl_init

[openssl_init]
providers = provider_sect
alg_section = algorithm_sect

[provider_sect]
default = default_sect
base = base_sect
tsra_provider = tsra_provider_sect

[default_sect]
activate = 1

[base_sect]
activate = 1

[tsra_provider_sect]
module = /usr/lib/x86_64-linux-gnu/ossl-modules/tsra_provider.so
activate = 1

# --- Key material paths ---
# BMK and MUK are auto-generated on first use if absent.
tsra-bmk-path = /var/lib/tsra/bmk.bin
tsra-muk-path = /var/lib/tsra/muk.bin

# OBK — 48-byte random owner backup key (required).
tsra-obk-path = /var/lib/tsra/obk.bin
tsra-obk-source = caller

# POTA attestation keys (required when tsra-pota-source = caller).
tsra-pota-source = caller
tsra-pota-private-key-path = /var/lib/tsra/pota_private_key.der
tsra-pota-public-key-path = /var/lib/tsra/pota_public_key.der

[algorithm_sect]
default_properties = ?provider=tsra
